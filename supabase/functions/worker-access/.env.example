# Server-only configuration for worker-access. Never expose these in Vite.
# Managed Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically. Do not copy or replace those secrets.
# Deploy with verify_jwt = false: login has no session, while protected operations
# validate the caller through Auth and enforce role/organization checks.
#
# Optional overrides for the private E2E stack only. JWT_SECRET is used only
# when both internal URLs are configured and no managed service key is present.
GOTRUE_INTERNAL_URL=
REST_INTERNAL_URL=
JWT_SECRET=
SUPABASE_ANON_KEY=
